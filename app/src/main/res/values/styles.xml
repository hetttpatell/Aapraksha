<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography -->
    <style name="Headline1">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/indigo_primary</item>
    </style>
    <style name="Headline2">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/midnight_blue</item>
    </style>
    <style name="Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">medium</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/slate_grey</item>
    </style>
    <style name="SOSLabel">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/neon_crimson</item>
    </style>
    <!-- Glassmorphic Card -->
    <style name="GlassmorphicCard">
        <item name="android:background">@color/surface_white</item>
        <item name="android:alpha">0.85</item>
        <item name="android:elevation">8dp</item>
        <item name="android:radius">16dp</item>
        <item name="android:strokeColor">@color/indigo_primary</item>
        <item name="android:strokeWidth">1dp</item>
    </style>
    <!-- TextInput -->
    <style name="TextInputField">
        <item name="android:background">@color/background_light</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/midnight_blue</item>
        <item name="android:focusable">true</item>
    </style>
</resources>