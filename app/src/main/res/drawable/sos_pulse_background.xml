<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow -->
    <item>
        <shape android:shape="oval">
            <size android:width="220dp" android:height="220dp"/>
            <solid android:color="#33FF0035"/>
        </shape>
    </item>
    <!-- Middle Glow -->
    <item>
        <shape android:shape="oval">
            <size android:width="180dp" android:height="180dp"/>
            <solid android:color="#66FF0035"/>
        </shape>
    </item>
    <!-- Inner Glow -->
    <item>
        <shape android:shape="oval">
            <size android:width="140dp" android:height="140dp"/>
            <solid android:color="#FF0035"/>
        </shape>
    </item>
</layer-list>