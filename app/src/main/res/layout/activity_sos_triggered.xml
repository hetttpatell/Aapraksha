<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_midnight">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/logo"
            android:contentDescription="App Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="AapRaksha"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/text_on_dark"
            android:textSize="16sp"
            android:letterSpacing="0.05" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/status_dot_active"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYSTEM SECURED"
            android:fontFamily="@font/montserrat"
            android:textColor="@color/electric_indigo_light"
            android:textSize="10sp"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <!-- Main Content ScrollView -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- Emergency SOS Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Emergency SOS"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_on_dark"
                android:textSize="24sp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp" />

            <!-- Countdown Text -->
            <TextView
                android:id="@+id/tv_countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Triggering alert in 3 seconds..."
                android:fontFamily="@font/montserrat"
                android:textColor="@color/slate_grey"
                android:textSize="12sp"
                android:layout_gravity="center"
                android:layout_marginTop="4dp" />

            <!-- SOS Button Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp">

                <!-- Pulse Rings -->
                <View
                    android:id="@+id/sos_pulse_1"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:background="@drawable/sos_pulse_ring"
                    android:visibility="visible" />

                <View
                    android:id="@+id/sos_pulse_2"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:background="@drawable/sos_pulse_ring"
                    android:visibility="visible" />

                <View
                    android:id="@+id/sos_pulse_3"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_gravity="center"
                    android:background="@drawable/sos_pulse_ring"
                    android:visibility="visible" />

                <!-- SOS Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_sos"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="80dp"
                    app:cardElevation="12dp"
                    app:cardBackgroundColor="@color/sos_red">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SOS"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/text_on_primary"
                            android:textSize="32sp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="03"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/text_on_primary"
                            android:textSize="28sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </FrameLayout>

            <!-- GPS Status Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/input_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/ic_location"
                        android:padding="4dp"
                        app:tint="@color/electric_indigo_light" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GPS STATUS"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/slate_grey"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cyber House 2, Gurgaon"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/text_on_dark"
                            android:textSize="14sp"
                            android:layout_marginTop="2dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last Updated: Just Now"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/slate_grey"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/status_dot_active" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Alert Message Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/input_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_notification"
                            app:tint="@color/electric_indigo_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ALERT MESSAGE"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/electric_indigo_light"
                            android:textSize="10sp"
                            android:layout_marginStart="8dp"
                            android:letterSpacing="0.1" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_alert_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Need emergency assistance at my current location. High priority alert triggered via Aapraksha. Tracking active."
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/text_on_dark"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Notification Status Cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <!-- Audio Notified -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/input_background_dark">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/electric_indigo_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AUDIO"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/slate_grey"
                            android:textSize="9sp"
                            android:layout_marginTop="8dp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_audio_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Notified"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/text_on_dark"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Video Notified -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/input_background_dark">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_camera"
                            app:tint="@color/electric_indigo_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VIDEO"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/slate_grey"
                            android:textSize="9sp"
                            android:layout_marginTop="8dp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_video_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 Notified"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/text_on_dark"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Message Notified -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/input_background_dark">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_email"
                            app:tint="@color/electric_indigo_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MESSAGE"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/slate_grey"
                            android:textSize="9sp"
                            android:layout_marginTop="8dp"
                            android:letterSpacing="0.1" />

                        <TextView
                            android:id="@+id/tv_message_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5 Notified"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/text_on_dark"
                            android:textSize="12sp"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Cancel SOS Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_cancel_sos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="@color/sos_red">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingVertical="16dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_delete"
                        app:tint="@color/text_on_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CANCEL SOS ALERT"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_on_primary"
                        android:textSize="16sp"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.1" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Cancel Info Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold to Cancel - System will auto-send in 5 s"
                android:fontFamily="@font/montserrat"
                android:textColor="@color/slate_grey"
                android:textSize="10sp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Navigation - FIXED/STICKY -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottom_nav_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0F1824"
        app:cardElevation="8dp"
        app:cardCornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:paddingTop="0dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/slate_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:fontFamily="@font/montserrat"
                    android:textColor="@color/slate_grey"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_safe_zones"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/slate_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alerts"
                    android:fontFamily="@font/montserrat"
                    android:textColor="@color/slate_grey"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/slate_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="History"
                    android:fontFamily="@font/montserrat"
                    android:textColor="@color/slate_grey"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/slate_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:fontFamily="@font/montserrat"
                    android:textColor="@color/slate_grey"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
