<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_midnight">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/logo"
            android:contentDescription="App Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="AapRaksha"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/electric_indigo_light"
            android:textSize="14sp"
            android:letterSpacing="0.05" />

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/status_dot_active"
            android:layout_marginEnd="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIVE"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/soft_lavender"
            android:textSize="9sp"
            android:letterSpacing="0.1" />

    </LinearLayout>

    <!-- Main Content ScrollView -->
    <ScrollView
        android:id="@+id/scroll_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <!-- Minimal Countdown Container -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp">

                <!-- Pulse Rings (Subtle, smaller) -->
                <View
                    android:id="@+id/sos_pulse_1"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:background="@drawable/sos_pulse_ring"
                    android:visibility="visible" />

                <View
                    android:id="@+id/sos_pulse_2"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:background="@drawable/sos_pulse_ring"
                    android:visibility="visible" />

                <View
                    android:id="@+id/sos_pulse_3"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:background="@drawable/sos_pulse_ring"
                    android:visibility="visible" />

                <!-- SOS Countdown Button (Minimal) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_sos"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="60dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@color/neon_crimson">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <TextView
                            android:id="@+id/tv_countdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="05"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/text_on_primary"
                            android:textSize="36sp"
                            android:letterSpacing="0.05" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="sec"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/text_on_primary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"
                            android:alpha="0.8" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </FrameLayout>

            <!-- Status Text (Minimal) -->
            <TextView
                android:id="@+id/tv_countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sending emergency alert..."
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/electric_indigo_light"
                android:textSize="13sp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.02" />

            <!-- Live Contact Counter Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/input_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/status_dot_active"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONTACTS NOTIFIED"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/electric_indigo_light"
                            android:textSize="10sp"
                            android:letterSpacing="0.1" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tv_contact_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/soft_lavender"
                            android:textSize="28sp"
                            android:letterSpacing="0.02" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/tv_contact_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sending..."
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/text_on_dark"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_failed_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 failed"
                                android:fontFamily="@font/montserrat"
                                android:textColor="@color/slate_grey"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Live Location Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/input_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location"
                            android:padding="2dp"
                            app:tint="@color/electric_indigo_light" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LIVE LOCATION"
                            android:fontFamily="@font/montserrat_bold"
                            android:textColor="@color/electric_indigo_light"
                            android:textSize="10sp"
                            android:layout_marginStart="8dp"
                            android:letterSpacing="0.1" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/status_dot_active"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tv_accuracy_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Updating"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/soft_lavender"
                            android:textSize="9sp" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_location_address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fetching location..."
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_on_dark"
                        android:textSize="13sp"
                        android:layout_marginTop="10dp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Latitude"
                                android:fontFamily="@font/montserrat"
                                android:textColor="@color/slate_grey"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tv_latitude"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/soft_lavender_light"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Longitude"
                                android:fontFamily="@font/montserrat"
                                android:textColor="@color/slate_grey"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tv_longitude"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/soft_lavender_light"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Accuracy"
                                android:fontFamily="@font/montserrat"
                                android:textColor="@color/slate_grey"
                                android:textSize="9sp" />

                            <TextView
                                android:id="@+id/tv_accuracy_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/soft_lavender_light"
                                android:textSize="11sp"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Emergency Message Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/input_background_dark">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ALERT MESSAGE"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/electric_indigo_light"
                        android:textSize="9sp"
                        android:letterSpacing="0.1" />

                    <TextView
                        android:id="@+id/tv_alert_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency assistance needed at my current location."
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/text_on_dark"
                        android:textSize="12sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginTop="8dp"
                        android:maxLines="3"
                        android:ellipsize="end" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Cancel SOS Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btn_cancel_sos"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/neon_crimson">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❌ CANCEL ALERT"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_on_primary"
                        android:textSize="13sp"
                        android:letterSpacing="0.05" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hold to cancel • Auto-send in background"
                android:fontFamily="@font/montserrat"
                android:textColor="@color/slate_grey"
                android:textSize="10sp"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.02" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
