<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_midnight"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Top Section -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You're Safe Now"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/text_on_dark"
            android:textSize="26sp"
            android:layout_marginTop="80dp"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency alert has been cancelled"
            android:fontFamily="@font/montserrat"
            android:textColor="@color/slate_grey"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Safe Button Container -->
        <FrameLayout
            android:id="@+id/safe_button_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

            <!-- Safe Button with Glow Effect -->
            <View
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:background="@drawable/sos_pulse_ring"
                android:backgroundTint="#4000FF00"
                android:alpha="0.3" />

            <androidx.cardview.widget.CardView
                android:id="@+id/btn_safe"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                app:cardCornerRadius="90dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#00C853">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_shield"
                        app:tint="@color/text_on_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NOW SAFE"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_on_primary"
                        android:textSize="22sp"
                        android:layout_marginTop="8dp"
                        android:letterSpacing="0.1" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </FrameLayout>

        <!-- Instructions Section -->
        <TextView
            android:id="@+id/tv_instructions_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="What to do next"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/text_on_dark"
            android:textSize="18sp"
            android:layout_marginTop="48dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/safe_button_container"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Instruction 1 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_instruction_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/input_background_dark"
            app:layout_constraintTop_toBottomOf="@id/tv_instructions_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#1A00C853">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="1"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#00C853"
                        android:textSize="20sp"
                        android:gravity="center" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Take a Deep Breath"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="You're safe now. Take a moment to calm down and breathe slowly."
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/slate_grey"
                        android:textSize="11sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Instruction 2 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_instruction_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/input_background_dark"
            app:layout_constraintTop_toBottomOf="@id/card_instruction_1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#1A00C853">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="2"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#00C853"
                        android:textSize="20sp"
                        android:gravity="center" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Check Your Surroundings"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Make sure you're in a safe location. Move to a public area if needed."
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/slate_grey"
                        android:textSize="11sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Instruction 3 -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_instruction_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/input_background_dark"
            app:layout_constraintTop_toBottomOf="@id/card_instruction_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#1A00C853">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="3"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="#00C853"
                        android:textSize="20sp"
                        android:gravity="center" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Inform Your Contacts"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_on_dark"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Let your emergency contacts know that you're safe now."
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/slate_grey"
                        android:textSize="11sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Priority Contact Section -->
        <TextView
            android:id="@+id/tv_priority_contact_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Priority Contact"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/text_on_dark"
            android:textSize="18sp"
            android:layout_marginTop="32dp"
            android:layout_marginStart="24dp"
            app:layout_constraintTop_toBottomOf="@id/card_instruction_3"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_priority_contact_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your emergency contact will be notified"
            android:fontFamily="@font/montserrat"
            android:textColor="@color/slate_grey"
            android:textSize="11sp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tv_priority_contact_title"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Priority Contact Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_priority_contact"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface_dark"
            app:layout_constraintTop_toBottomOf="@id/tv_priority_contact_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <!-- Profile Circle -->
                <androidx.cardview.widget.CardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/electric_indigo">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/text_on_primary" />

                </androidx.cardview.widget.CardView>

                <!-- Contact Details -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tv_contact_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="John Doe"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/text_on_dark"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/tv_contact_relation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Father"
                        android:fontFamily="@font/montserrat"
                        android:textColor="@color/electric_indigo_light"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/slate_grey" />

                        <TextView
                            android:id="@+id/tv_contact_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+91 98765 43210"
                            android:fontFamily="@font/montserrat"
                            android:textColor="@color/slate_grey"
                            android:textSize="12sp"
                            android:layout_marginStart="6dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Call Button -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/btn_call_contact"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#00C853">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_call"
                        app:tint="@color/text_on_primary" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Back to Dashboard Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_back_to_dashboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/electric_indigo"
            app:layout_constraintTop_toBottomOf="@id/card_priority_contact"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Back to Dashboard"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_on_primary"
                android:textSize="16sp"
                android:gravity="center"
                android:paddingVertical="16dp"
                android:letterSpacing="0.05" />

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
