<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ob_gradient"
    tools:context=".ResponseOptionsActivity">

    <!-- Top Navigation Bar - Professional Glass Header -->
    <androidx.cardview.widget.CardView
        android:id="@+id/top_nav_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#1AFFFFFF"
        app:cardElevation="0dp"
        app:cardCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_glass_panel"
                android:backgroundTint="#20FFFFFF"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/text_on_dark"
                android:padding="10dp"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMERGENCY RESPONSE"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/text_on_dark"
                    android:textSize="14sp"
                    android:letterSpacing="0.15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active Protocol"
                    android:fontFamily="@font/montserrat_medium"
                    android:textColor="@color/slate_grey"
                    android:letterSpacing="0.05"
                    android:textSize="10sp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipChildren="false"
        app:layout_constraintTop_toBottomOf="@id/top_nav_card"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp"
            android:paddingBottom="48dp"
            android:clipChildren="false">

            <!-- Triple Pulse Visual for SOS -->
            <FrameLayout
                android:id="@+id/pulse_container"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:clipChildren="false"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Ring 3 (Outer) -->
                <ImageView
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center"
                    android:src="@drawable/sos_pulse_ring"
                    android:alpha="0.05"
                    app:tint="@color/sos_red" />

                <!-- Ring 2 -->
                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:src="@drawable/sos_pulse_ring"
                    android:alpha="0.1"
                    app:tint="@color/sos_red" />

                <!-- Ring 1 (Inner) -->
                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:src="@drawable/sos_pulse_ring"
                    android:alpha="0.2"
                    app:tint="@color/sos_red" />

                <!-- Glow Layer -->
                <View
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="center"
                    android:background="@drawable/sos_pulse_circle"
                    android:backgroundTint="@color/sos_red"
                    android:alpha="0.15" />

                <!-- Main Emblem -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/alert_icon_card"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="55dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardElevation="12dp">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glass_panel"
                        android:alpha="0.5" />

                    <ImageView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_alert"
                        app:tint="@color/sos_red" />

                </androidx.cardview.widget.CardView>

            </FrameLayout>

            <!-- User Context Section -->
            <TextView
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text=""
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_on_dark"
                android:textSize="28sp"
                app:layout_constraintTop_toBottomOf="@id/pulse_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/status_badge_bg"
                android:paddingHorizontal="16dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/user_name"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/status_dot_active"
                    android:backgroundTint="@color/sos_red" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="SOS SIGNAL DETECTED"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/sos_red"
                    android:textSize="11sp"
                    android:letterSpacing="0.1" />

            </LinearLayout>

            <TextView
                android:id="@+id/location_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="---"
                android:fontFamily="@font/montserrat_medium"
                android:textColor="@color/text_on_dark"
                android:textSize="14sp"
                android:alpha="0.9"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/status_badge" />

            <TextView
                android:id="@+id/time_ago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="---"
                android:fontFamily="@font/montserrat"
                android:textColor="@color/slate_grey"
                android:textSize="12sp"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/location_address"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/tv_instruction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="SELECT RESPONSE STRATEGY"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/slate_grey"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:gravity="center"
                app:layout_constraintTop_toBottomOf="@id/time_ago" />

            <!-- Primary Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/tv_instruction">

                <!-- Track Location Action -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/view_on_map_btn"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    android:layout_marginBottom="20dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="@color/surface_dark"
                    app:cardElevation="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_glass_panel"
                        android:alpha="0.4" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="24dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_location_pin"
                            android:background="@drawable/bg_glass_panel"
                            android:backgroundTint="#1A7B93FF"
                            android:padding="10dp"
                            app:tint="@color/electric_indigo_light" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Live Monitor"
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/text_on_dark"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Real-time GPS Tracking"
                                android:fontFamily="@font/montserrat_medium"
                                android:textColor="@color/slate_grey"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/slate_grey" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Voice Communication Action -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/call_now_btn"
                    android:layout_width="match_parent"
                    android:layout_height="96dp"
                    app:cardCornerRadius="24dp"
                    app:cardBackgroundColor="@color/electric_indigo"
                    app:cardElevation="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="24dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:src="@drawable/ic_call"
                            android:background="@drawable/bg_glass_panel"
                            android:backgroundTint="#33FFFFFF"
                            android:padding="10dp"
                            app:tint="@color/text_on_primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="20dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Voice Contact"
                                android:fontFamily="@font/montserrat_bold"
                                android:textColor="@color/text_on_primary"
                                android:textSize="17sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Direct Emergency Priority line"
                                android:fontFamily="@font/montserrat_medium"
                                android:textColor="@color/text_on_primary"
                                android:alpha="0.8"
                                android:textSize="12sp" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_arrow_forward"
                            app:tint="@color/text_on_primary" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
