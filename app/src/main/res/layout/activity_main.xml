<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_midnight"
    tools:context=".MainActivity">

    <!-- App Logo in toolbar area -->
    <ImageView
        android:id="@+id/home_logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter"
        android:contentDescription="@string/app_logo_description"
        android:layout_marginStart="20dp"
        android:layout_marginTop="52dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- App Name beside logo -->
    <TextView
        android:id="@+id/home_app_name"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/montserrat_extrabold"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="@id/home_logo"
        app:layout_constraintBottom_toBottomOf="@id/home_logo"
        app:layout_constraintStart_toEndOf="@id/home_logo" />

</androidx.constraintlayout.widget.ConstraintLayout>