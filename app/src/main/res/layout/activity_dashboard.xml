<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_midnight"
    tools:context=".DashboardActivity">

    <!-- Top Navigation Bar - FIXED/STICKY -->
    <androidx.cardview.widget.CardView
        android:id="@+id/top_nav_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0F1824"
        app:cardElevation="16dp"
        android:outlineAmbientShadowColor="#000000"
        android:outlineSpotShadowColor="@color/electric_indigo_light"
        tools:targetApi="p"
        app:cardCornerRadius="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="40dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/logo"
                android:contentDescription="App Logo" />

            <TextView
                android:id="@+id/username_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Username"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/text_on_dark"
                android:textSize="16sp"
                android:letterSpacing="0.05" />

            <ImageView
                android:id="@+id/btn_notifications"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_notification"
                android:layout_marginEnd="20dp"
                android:contentDescription="Notifications"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_on_dark" />

            <ImageView
                android:id="@+id/btn_profile"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile"
                android:contentDescription="Profile"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/text_on_dark" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Bottom Navigation - FIXED/STICKY -->
    <androidx.cardview.widget.CardView
        android:id="@+id/bottom_nav_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#0F1824"
        app:cardElevation="16dp"
        android:outlineAmbientShadowColor="#000000"
        android:outlineSpotShadowColor="@color/electric_indigo_light"
        tools:targetApi="p"
        app:cardCornerRadius="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:orientation="horizontal"
            android:paddingTop="0dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_home"
                    app:tint="@color/electric_indigo_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="HOME"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textColor="@color/electric_indigo_light"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_safe_zones"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.5"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_alert"
                    app:tint="@color/slate_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ALERTS"
                    android:fontFamily="@font/montserrat_medium"
                    android:textColor="@color/slate_grey"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_history"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.5"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/slate_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="HISTORY"
                    android:fontFamily="@font/montserrat_medium"
                    android:textColor="@color/slate_grey"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/nav_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:alpha="0.5"
                android:background="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/slate_grey" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="SETTINGS"
                    android:fontFamily="@font/montserrat_medium"
                    android:textColor="@color/slate_grey"
                    android:textSize="10sp"
                    android:letterSpacing="0.05" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/top_nav_card"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_card">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="20dp">

    <!-- System Status -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/system_status_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#1A2942"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/card_stroke_dark"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/system_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/status_dot_active" />

            <TextView
                android:id="@+id/tv_system_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="System Active &amp; Monitoring"
                android:fontFamily="@font/montserrat_medium"
                android:textColor="#4FFFB0"
                android:textSize="13sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SOS Button Container - EXPANDED to prevent clipping -->
    <FrameLayout
        android:id="@+id/sos_container"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_marginTop="48dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/system_status_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Pulse rings - using ImageView for perfect circular rings -->
        <ImageView
            android:id="@+id/sos_pulse_3"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:src="@drawable/bg_sos_radial_glow"
            android:contentDescription="Pulse Ring"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/sos_pulse_2"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:src="@drawable/bg_sos_radial_glow"
            android:contentDescription="Pulse Ring"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/sos_pulse_1"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:src="@drawable/bg_sos_radial_glow"
            android:contentDescription="Pulse Ring"
            android:visibility="invisible" />

        <!-- Main SOS Button - CIRCLE SHAPE -->
        <LinearLayout
            android:id="@+id/btn_sos"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_sos_button_premium"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SOS"
                android:fontFamily="@font/montserrat_extrabold"
                android:textColor="@color/white"
                android:textSize="64sp"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="TAP TO ACTIVATE"
                android:fontFamily="@font/montserrat_semibold"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:letterSpacing="0.15" />

        </LinearLayout>

    </FrameLayout>

    <!-- SOS Status Indicator -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sos_status_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#1A2942"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/card_stroke_dark"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/sos_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/sos_status_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/status_dot_inactive" />

            <TextView
                android:id="@+id/tv_sos_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="INACTIVE"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/slate_grey"
                android:textSize="12sp"
                android:letterSpacing="0.1" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SOS Info Text -->
    <TextView
        android:id="@+id/tv_sos_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tap SOS or press volume button 3x in emergency."
        android:fontFamily="@font/montserrat_regular"
        android:textColor="@color/slate_grey"
        android:textSize="12sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/sos_status_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Feature Cards -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_emergency_contacts"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="#1A2942"
        app:cardCornerRadius="14dp"
        app:strokeColor="@color/card_stroke_dark"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/tv_sos_info"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_contacts"
                android:padding="6dp"
                android:background="@drawable/feature_icon_bg"
                app:tint="@color/electric_indigo_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Manage Emergency Contacts"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textColor="@color/text_on_dark"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="contacts notified during SOS"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="@color/slate_grey"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/slate_grey" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- GPS Card -->
    <LinearLayout
        android:id="@+id/feature_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/card_emergency_contacts"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_gps"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_weight="1"
            app:cardBackgroundColor="#1A2942"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/card_stroke_dark"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_location"
                    android:padding="4dp"
                    android:background="@drawable/feature_icon_bg"
                    app:tint="@color/electric_indigo_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Real-time GPS"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textColor="@color/text_on_dark"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Enabled &amp; Secure"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="@color/slate_grey"
                    android:textSize="10sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_ai_assistant"
            android:layout_width="0dp"
            android:layout_height="105dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            app:cardBackgroundColor="#1A2942"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/card_stroke_dark"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_shield"
                    android:padding="4dp"
                    android:background="@drawable/feature_icon_bg"
                    app:tint="@color/electric_indigo_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="AI Safety"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textColor="@color/text_on_dark"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Chat assistant"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="@color/slate_grey"
                    android:textSize="10sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_fake_call"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="#1A2942"
        app:cardCornerRadius="14dp"
        app:strokeColor="@color/card_stroke_dark"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintTop_toBottomOf="@id/feature_row"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_call"
                android:padding="6dp"
                android:background="@drawable/feature_icon_bg"
                app:tint="@color/electric_indigo_light" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fake Distraction Call"
                    android:fontFamily="@font/montserrat_semibold"
                    android:textColor="@color/text_on_dark"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tap to trigger instantly"
                    android:fontFamily="@font/montserrat_regular"
                    android:textColor="@color/slate_grey"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="@color/slate_grey" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Onboarding Tutorial Overlay (Emergency Contacts) - Premium Redesign -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/overlay_tutorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6030303"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:clipChildren="false"
        android:elevation="99dp">

     <!-- Tutorial Message Container - Frosted Glass Premium Card -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tutorial_message_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingBottom="36dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/bg_glass_panel"
        android:backgroundTint="#FA000000"
        android:elevation="24dp"
        android:outlineAmbientShadowColor="#000000"
        android:outlineSpotShadowColor="@color/electric_indigo_light"
        app:layout_constraintBottom_toTopOf="@id/tutorial_highlight_area"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp">

        <!-- Top glowing accent -->
        <View
            android:id="@+id/tutorial_top_glow"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@drawable/button_primary_gradient"
            android:alpha="0.8"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Animated pulse backdrop for icon -->
        <View
            android:id="@+id/tutorial_pulse_bg"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_sos_radial_glow"
            android:alpha="0.4"
            app:layout_constraintTop_toBottomOf="@id/tutorial_top_glow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Icon Container -->
        <FrameLayout
            android:id="@+id/tutorial_icon_container"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/feature_icon_bg"
            android:backgroundTint="#267B93FF"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="@id/tutorial_pulse_bg"
            app:layout_constraintBottom_toBottomOf="@id/tutorial_pulse_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_contacts"
                app:tint="@color/electric_indigo_light" />

        </FrameLayout>

        <!-- Status Badge -->
        <LinearLayout
            android:id="@+id/tutorial_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="#1A7B93FF"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tutorial_icon_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/status_dot_active"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRITICAL STEP"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="@color/electric_indigo_light"
                android:textSize="9sp"
                android:letterSpacing="0.2" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tutorial_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Add Trusted Contacts"
            android:fontFamily="@font/montserrat_extrabold"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:letterSpacing="-0.02"
            app:layout_constraintTop_toBottomOf="@id/tutorial_badge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle/Description -->
        <TextView
            android:id="@+id/tutorial_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="28dp"
            android:text="SOS protection is inactive. You must add at least one trusted contact to notify in case of an emergency."
            android:fontFamily="@font/montserrat_medium"
            android:textColor="@color/slate_grey"
            android:textSize="13sp"
            android:textAlignment="center"
            android:lineSpacingMultiplier="1.4"
            app:layout_constraintTop_toBottomOf="@id/tutorial_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Action Hint -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp"
            android:alpha="0.8"
            app:layout_constraintTop_toBottomOf="@id/tutorial_description"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAP HIGHLIGHTED AREA"
                android:fontFamily="@font/montserrat_bold"
                android:textColor="#A0AABF"
                android:textSize="10sp"
                android:letterSpacing="0.15" />
                
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_arrow_forward"
                app:tint="#A0AABF"
                android:rotation="90"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Dynamic Highlight Area (Premium Glow) - Accurate Positioning -->
        <View
            android:id="@+id/tutorial_highlight_area"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/tutorial_highlight_bg"
            android:elevation="100dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Floating Spotlight Label -->
        <TextView
            android:id="@+id/tutorial_spotlight_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADD CONTACT TO START"
            android:textColor="@color/white"
            android:fontFamily="@font/montserrat_bold"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:elevation="101dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:background="@drawable/status_badge_bg"
            android:backgroundTint="#80000000"
            app:layout_constraintBottom_toTopOf="@id/tutorial_highlight_area"
            app:layout_constraintStart_toStartOf="@id/tutorial_highlight_area"
            app:layout_constraintEnd_toEndOf="@id/tutorial_highlight_area"
            android:layout_marginBottom="12dp" />

        <!-- <TextView
            android:id="@+id/btn_got_it"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="INITIALIZE SETUP"
            android:fontFamily="@font/montserrat_bold"
            android:textColor="@color/electric_indigo_light"
            android:textSize="14sp"
            android:letterSpacing="0.15"
            android:paddingHorizontal="32dp"
            android:paddingVertical="14dp"
            android:background="@drawable/bg_glass_panel"
            android:backgroundTint="#1A7B93FF"
            app:layout_constraintTop_toBottomOf="@id/tutorial_spotlight_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/> -->

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
