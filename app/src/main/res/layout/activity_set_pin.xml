<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/deep_midnight"
    tools:context=".SetPinActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="Secure Your App"
        android:fontFamily="@font/montserrat_extrabold"
        android:textColor="@color/text_on_dark"
        android:textSize="32sp"
        android:letterSpacing="0.05"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle text -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Please set a 4-digit emergency PIN. This PIN will be required to stop SOS alerts."
        android:fontFamily="@font/montserrat_regular"
        android:textColor="@color/slate_grey"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Pin Input Field -->
    <LinearLayout
        android:id="@+id/ll_pin_input"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="32dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_login_input"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="Lock Icon"
            app:tint="@color/electric_indigo_light" />

        <EditText
            android:id="@+id/et_pin_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/montserrat_semibold"
            android:hint="Enter 4-digit PIN"
            android:textColorHint="@color/slate_grey"
            android:textColor="@color/text_on_dark"
            android:textSize="20sp"
            android:letterSpacing="0.2"
            android:inputType="numberPassword"
            android:maxLength="4"
            android:maxLines="1"
            android:gravity="center_vertical"
            android:paddingVertical="0dp" />
    </LinearLayout>
    
    <TextView
        android:id="@+id/tv_pin_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Make sure it's something you will remember in an emergency."
        android:fontFamily="@font/montserrat_medium"
        android:textColor="@color/slate_grey"
        android:textSize="12sp"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/ll_pin_input"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Save Pin Button -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_save_pin"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_button_login"
        android:text="Save PIN &amp; Continue"
        android:fontFamily="@font/montserrat_bold"
        android:textColor="@color/text_on_primary"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_pin_hint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
